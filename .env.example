# DATABASE_URL: Connection string PostgreSQL eksternal (Neon / Supabase / Railway).
# Contoh Neon: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Contoh Supabase Pooler: postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls (optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
